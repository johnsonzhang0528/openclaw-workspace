# Agent Monitoring System 環境變數設定
# 複製此檔案為 .env 並修改設定值

# ============================================
# Telegram 配置
# ============================================

# Telegram Bot Token (從 @BotFather 獲取)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram 聊天 ID (個人或群組)
TELEGRAM_CHAT_ID=your_chat_id_here

# 是否禁用通知聲音
TELEGRAM_DISABLE_NOTIFICATION=false

# ============================================
# 監控配置
# ============================================

# 監控輪詢間隔（秒）
MONITORING_POLLING_INTERVAL=30

# 歷史數據保留天數
MONITORING_HISTORY_RETENTION_DAYS=7

# CPU 使用率警告閾值（百分比）
MONITORING_CPU_THRESHOLD=80

# 記憶體使用率警告閾值（百分比）
MONITORING_MEMORY_THRESHOLD=85

# 磁碟使用率警告閾值（百分比）
MONITORING_DISK_THRESHOLD=90

# ============================================
# 儀表板配置
# ============================================

# 是否使用精簡模式儀表板
DASHBOARD_COMPACT_MODE=false

# 儀表板更新間隔（秒）
DASHBOARD_UPDATE_INTERVAL=30

# ============================================
# 警報配置
# ============================================

# 是否啟用郵件警報
ALERT_ENABLE_EMAIL_ALERTS=false

# 是否啟用簡訊警報
ALERT_ENABLE_SMS_ALERTS=false

# ============================================
# 整合配置
# ============================================

# 是否啟用議題追蹤整合
INTEGRATION_ENABLE_ISSUE_TRACKER=true

# 是否啟用 OpenClaw 會話整合
INTEGRATION_ENABLE_OPENCLAW_SESSIONS=true

# ============================================
# 進階配置
# ============================================

# 數據庫檔案路徑（預設：monitoring.db）
# DATABASE_PATH=monitoring.db

# 日誌級別（DEBUG, INFO, WARNING, ERROR）
# LOG_LEVEL=INFO

# 日誌檔案路徑
# LOG_FILE=monitoring.log