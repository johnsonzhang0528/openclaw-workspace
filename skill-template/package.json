{
  "name": "{{skill_name}}",
  "version": "1.0.0",
  "description": "{{description}}",
  "main": "main.py",
  "author": "{{author}}",
  "license": "MIT",
  "openclaw": {
    "skill": true,
    "category": "{{category}}",
    "commands": [
      {
        "command": "/{{command_prefix}}",
        "description": "{{skill_description}}",
        "handler": "main.handle_command"
      }
    ],
    "dependencies": {
      "python": [
        "requests>=2.28.0",
        "psutil>=5.9.0"
      ],
      "system": []
    },
    "config_schema": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "啟用此技能"
      },
      "telegram_enabled": {
        "type": "boolean",
        "default": true,
        "description": "啟用 Telegram 介面"
      },
      "data_path": {
        "type": "string",
        "default": "/root/.openclaw/workspace/{{skill_name}}",
        "description": "資料儲存路徑"
      }
    }
  },
  "scripts": {
    "test": "python -m pytest tests/",
    "dev": "python dev-tools/watch.py {{skill_name}}",
    "build": "python dev-tools/skill-builder.py package {{skill_name}}",
    "install": "sudo python dev-tools/skill-builder.py install {{skill_name}}.tar.gz"
  },
  "repository": {
    "type": "git",
    "url": "{{repository_url}}"
  },
  "bugs": {
    "url": "{{issues_url}}"
  },
  "homepage": "{{homepage_url}}",
  "keywords": [
    "openclaw",
    "skill",
    "{{category}}",
    "telegram"
  ]
}