{
  "name": "skills-marketplace",
  "version": "1.0.0",
  "description": "技能市集瀏覽器 - 瀏覽和安裝第三方技能",
  "main": "main.py",
  "author": "OpenClaw Team",
  "license": "MIT",
  "openclaw": {
    "skill": true,
    "category": "marketplace",
    "commands": [
      {
        "command": "/技能市集",
        "description": "打開技能市集主選單",
        "handler": "main.handle_command"
      },
      {
        "command": "/market",
        "description": "技能市集快捷命令",
        "handler": "main.handle_command"
      }
    ],
    "dependencies": {
      "python": [
        "requests>=2.28.0",
        "beautifulsoup4>=4.11.0",
        "psutil>=5.9.0"
      ],
      "system": []
    },
    "config_schema": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "啟用技能市集"
      },
      "telegram_enabled": {
        "type": "boolean",
        "default": true,
        "description": "啟用 Telegram 介面"
      },
      "data_path": {
        "type": "string",
        "default": "/root/.openclaw/workspace/skills-marketplace",
        "description": "資料儲存路徑"
      },
      "catalog_url": {
        "type": "string",
        "default": "https://clawhub.com/api/skills",
        "description": "技能目錄 API URL"
      },
      "cache_duration": {
        "type": "number",
        "default": 3600,
        "description": "快取時間（秒）"
      },
      "auto_update_check": {
        "type": "boolean",
        "default": true,
        "description": "自動檢查更新"
      },
      "default_sort": {
        "type": "string",
        "default": "popularity",
        "description": "預設排序方式",
        "enum": ["popularity", "rating", "name", "updated"]
      }
    }
  },
  "scripts": {
    "test": "python -m pytest tests/",
    "dev": "python dev-tools/watch.py skills-marketplace",
    "build": "python dev-tools/skill-builder.py package skills-marketplace",
    "install": "sudo python dev-tools/skill-builder.py install skills-marketplace.tar.gz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/skills-marketplace"
  },
  "bugs": {
    "url": "https://github.com/openclaw/skills-marketplace/issues"
  },
  "homepage": "https://clawhub.com/skills/marketplace",
  "keywords": [
    "openclaw",
    "skill",
    "marketplace",
    "skills",
    "browser",
    "telegram"
  ]
}