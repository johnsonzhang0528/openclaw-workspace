{
  "name": "workspace-manager",
  "version": "2.0.0",
  "description": "Complete workspace management tool with file browser, directory navigation, and file operations",
  "author": "OpenClaw Team",
  "license": "MIT",
  "main": "main.py",
  "scripts": {
    "start": "python main.py",
    "test": "python -m pytest tests/",
    "install": "pip install -r requirements.txt",
    "clean": "rm -rf __pycache__ *.pyc data/cache/*.json"
  },
  "dependencies": {
    "python": ">=3.8",
    "pillow": ">=9.0.0",
    "chardet": ">=5.0.0",
    "python-magic": ">=0.4.27"
  },
  "openclaw": {
    "skill_type": "workspace",
    "compatibility": {
      "min_version": "2026.2.0",
      "max_version": "2026.12.0"
    },
    "permissions": [
      "read_files",
      "write_files",
      "list_directory",
      "telegram_ui"
    ],
    "telegram": {
      "commands": [
        {
          "command": "workspace",
          "description": "Open workspace management menu"
        },
        {
          "command": "ws",
          "description": "Workspace shortcut command"
        },
        {
          "command": "file_browse",
          "description": "Browse file directory"
        },
        {
          "command": "file_search",
          "description": "Search files and content"
        },
        {
          "command": "file_edit",
          "description": "Edit text files"
        }
      ],
      "inline_keyboards": true,
      "callback_queries": true
    }
  },
  "keywords": [
    "workspace",
    "file-manager",
    "browser",
    "editor",
    "search",
    "openclaw",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/workspace-manager.git"
  },
  "bugs": {
    "url": "https://github.com/openclaw/workspace-manager/issues"
  },
  "homepage": "https://github.com/openclaw/workspace-manager#readme"
}